{
  "name": "Telegram Mega Game Bot",
  "description": "A complete multiplayer gaming platform with 13 games",
  "repository": "https://github.com/yourusername/telegram-mega-game",
  "keywords": ["telegram", "game", "bot", "multiplayer", "mongodb"],
  "env": {
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token",
      "required": true
    },
    "MONGO_DB_URI": {
      "description": "MongoDB Connection String",
      "required": true
    },
    "DATABASE_NAME": {
      "description": "Database Name",
      "required": true,
      "value": "telegram_mega_game"
    },
    "ADMIN_IDS": {
      "description": "Admin Telegram IDs (comma separated)",
      "required": true
    },
    "LOG_CHANNEL_ID": {
      "description": "Log Channel ID",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
